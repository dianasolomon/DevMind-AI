# ── LLM Provider (Groq / OpenAI compatible) ──
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_NAME=openai/gpt-oss-120b

# ── Retrieval ──
# Minimum similarity score threshold for chunks (default: 0.35)
SCORE_THRESHOLD=0.35

# ── Qdrant Vector Store ──
# Leave empty to use local file-based storage (./qdrant_data)
# Or set to remote instance: http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=devmind_chunks

# ── Embedding Model ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Server ──
HOST=0.0.0.0
PORT=8000
