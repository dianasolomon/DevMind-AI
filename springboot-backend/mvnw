#!/bin/sh
# ----------------------------------------------------------------------------
# Maven wrapper shell script for Linux/Mac
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ]; then
    JAVA_CMD="java"
else
    JAVA_CMD="$JAVA_HOME/bin/java"
fi

MAVEN_PROJECTBASEDIR="$(pwd)"

# Locate .mvn directory
while [ "$MAVEN_PROJECTBASEDIR" != "/" ]; do
    if [ -d "$MAVEN_PROJECTBASEDIR/.mvn" ]; then
        break
    fi
    MAVEN_PROJECTBASEDIR="$(dirname "$MAVEN_PROJECTBASEDIR")"
done

WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

# Download the wrapper jar if not present
if [ ! -e "$WRAPPER_JAR" ]; then
    WRAPPER_URL=$(grep "wrapperUrl" "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties" | cut -d'=' -f2)
    curl -o "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || \
    wget -O "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null
fi

exec "$JAVA_CMD" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  $WRAPPER_LAUNCHER \
  "$@"
